<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- targetSdk 36: package visibility is filtered, so both packages the UI
         inspects or launches must be declared explicitly. -->
    <queries>
        <package android:name="com.techbao.controlphone" />
        <package android:name="org.lsposed.manager" />
    </queries>

    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/module_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ControlPhoneUnlock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/module_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
